    <img src="/images/togs/t-shirt2-back.png" />

      <div class="stack" style="--space: var(--space-2xs);">
        <p class="code-label">the symbiont</p>
        <div class="tee-mockup">
          <div class="stack" style="--space: var(--space-3xs);">
            <p class="tee-overline">ADTs &middot; Lisp Macros &middot; ECMAScript-compatibility &middot; Rust compiler</p>
            <p class="tee-slogan">A language of SYMBIOSIS</p>
          </div>
          <pre><code><span class="sc">;;; audit.lykn — security AND beauty ... by design</span>

(<span class="sk">import</span> <span class="ss">"./trust.js"</span> (vetted? ship refuse))

(<span class="sk">type</span> <span class="sf">Outcome</span>
  (<span class="sf">Ok</span> <span class="st">:any</span> value)
  (<span class="sf">Err</span> <span class="st">:string</span> reason))

(<span class="sk">bind</span> dep (<span class="sk">obj</span> <span class="st">:name</span> <span class="ss">"left-pad"</span> <span class="st">:from</span> <span class="ss">"npm"</span>))

(<span class="sk">func</span> <span class="sf">audit</span>
  <span class="st">:args</span> (<span class="st">:object</span> dep)
  <span class="st">:body</span> (<span class="sk">if</span> (<span class="sf">vetted?</span> dep)
          (<span class="sf">Ok</span> dep)
          (<span class="sf">Err</span> <span class="ss">"supply chain"</span>)))

(<span class="sk">export</span> (names <span class="sf">audit</span>))

(<span class="sk">match</span> (<span class="sf">audit</span> dep)
  ((<span class="sf">Ok</span> v)  (<span class="sf">ship</span> v))
  ((<span class="sf">Err</span> e) (<span class="sf">refuse</span> e)))</code></pre>
        </div>
      </div>
